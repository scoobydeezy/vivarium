    ratePerMinuteDenominator: 1
    behaviouralThresholds:
    behaviouralThresholdValues:
    - 7000
    socializingRoutine:
      activityDefinitionId: activity.socializing
      activationThreshold: 7000
      satisfactionOffset: -5000
      maxCandidates: 4
  activities:
  - authoredId: activity.working
    displayName: Working
