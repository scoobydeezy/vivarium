          sourceParameterId: ''
        - parameterId: decision.parameter.urgency
          source: 1
          sourceParameterId: decision.parameter.urgency
        signals:
        - signalId: decision.parameter.urgency
          providerId: decision.signal_provider.context
        field:
          authoredId: field.leave_work.hunger
          bias: 0
          revision: 1
          linearTerms:
          - signalId: decision.parameter.urgency
            coefficient: 10000
            provenanceId: reason.hunger
          pairwiseTerms: []
          idealPoint: []
          idealFactors: []
        reasonChannelId: reason_channel.physical_urgency
        consolidationPolicy: 0
        scaleId: reason_scale.hunger
