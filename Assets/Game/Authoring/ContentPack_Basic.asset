      - dimensionId: social.dimension.warmth
        coefficient: 7000
      - dimensionId: social.dimension.sociability
        coefficient: 3000
      observedValue: 4000
      noiseVariance: 30000000
  socialPressures:
  - authoredId: social.pressure.seek_company
