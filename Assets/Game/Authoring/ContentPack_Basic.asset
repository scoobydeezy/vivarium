  - {fileID: 11400000, guid: 4468f27faf43b5949bbf2a8be776698f, type: 2}
  needs:
  - authoredId: need.hunger
    displayName: Hunger
    minValue: 0
    maxValue: 10000
    ratePerMinuteNumerator: 12
    ratePerMinuteDenominator: 1
    behaviouralThresholds: 
    behaviouralThresholdValues:
    - 6000
    - 8000
    - 9500
    satisfactionRoutine:
      activityDefinitionId: activity.eating
      activationThreshold: 6000
      satisfactionOffset: -5000
  - authoredId: need.recreation
    displayName: Recreation
    minValue: 0
    maxValue: 10000
    ratePerMinuteNumerator: 2
    ratePerMinuteDenominator: 1
    behaviouralThresholds:
    behaviouralThresholdValues:
    - 6000
    recreationRoutine:
      decisionDefinitionId: decision.choose_recreation
      activationThreshold: 6000
      satisfactionOffset: -5000
      candidates:
      - optionId: option.recreation.tabletop_games
        activityDefinitionId: activity.tabletop_games
        interestId: interest.tabletop_games
      - optionId: option.recreation.reading
        activityDefinitionId: activity.reading
        interestId: interest.reading
  - authoredId: need.social
