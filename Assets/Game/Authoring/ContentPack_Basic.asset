MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: efa2c788149cc734eaa878ceb97ac2b0, type: 3}
  m_Name: ContentPack_Basic
  m_EditorClassIdentifier: Vivarium.Unity.Authoring::Vivarium.Unity.Authoring.ContentPackAsset
  contentVersion: 2
  traits:
  - {fileID: 11400000, guid: afe9983f40078e045a269c0c1854d889, type: 2}
  - {fileID: 11400000, guid: cf50c39fa4f24f64ca6fccdf406a2d68, type: 2}
  - {fileID: 11400000, guid: 4468f27faf43b5949bbf2a8be776698f, type: 2}
  needs:
  - authoredId: need.hunger
    displayName: Hunger
    minValue: 0
    maxValue: 10000
    ratePerMinuteNumerator: 12
    ratePerMinuteDenominator: 1
    behaviouralThresholds: 
  activities:
  - authoredId: activity.working
    displayName: Working
    defaultDurationMinutes: 5
    producesOutcome: 1
    supportsInteractiveResolution: 1
    isTravel: 0
  locationKindIds:
  - location_kind.building
  decisions:
  - authoredId: decision.leave_work_early
    options:
    - authoredId: option.leave
      labelId: Leave work early
      orderIndex: 0
    - authoredId: option.stay
      labelId: Finish the shift
      orderIndex: 1
    timeToResolveMinutes: 10
    conflictScopeKindId: conflict_scope.current_activity
    importance: 20
    holdEligible: 1
    dependencies:
    - contextKindId: decision_context.work_pressure
    trigger:
      needId: need.hunger
      threshold: 6000
    influences:
    - optionId: option.leave
      categoryId: influence_category.personal_concern
      labelId: Hunger
      dieSides: 20
      visibility: 31
      subjectIsCharacter: 1
    - optionId: option.leave
      categoryId: influence_category.social
      labelId: Difficult work context
      dieSides: 10
      visibility: 11
      subjectIsCharacter: 1
    - optionId: option.stay
      categoryId: influence_category.practical
      labelId: Reliability
      dieSides: 6
      visibility: 31
      subjectIsCharacter: 0
    activityOutcomes:
    - optionId: option.leave
      activityDefinitionId: activity.waiting
      durationMinutes: 60
  - authoredId: decision.seek_company
    options:
    - authoredId: option.seek_company
      labelId: Seek their company
      orderIndex: 0
    - authoredId: option.avoid_company
      labelId: Keep distance
      orderIndex: 1
    timeToResolveMinutes: 10
    conflictScopeKindId: conflict_scope.social_target
    importance: 12
    holdEligible: 0
    socialTrigger:
      pressureDefinitionId: social.pressure.seek_company
      lensId: social.lens.affiliation
      positiveOptionId: option.seek_company
      negativeOptionId: option.avoid_company
      categoryId: influence_category.social
      positiveLabelId: influence.enjoys_company
      negativeLabelId: influence.avoids_company
      visibility: 31
      minimumStrength: 1
    relationshipOutcomes:
    - optionId: option.seek_company
      channelId: relationship.channel.affection
      delta: 1000
    - optionId: option.avoid_company
      channelId: relationship.channel.resentment
      delta: 500
  interventions:
  - authoredId: intervention.encourage
    kind: 2
    cost: 1
  appraisalCalibrations:
  - authoredId: social.calibration.standard
    version: 1
    thresholds:
    - minimumMagnitude: 1000
      strength: 1
    - minimumMagnitude: 2500
      strength: 2
    - minimumMagnitude: 5000
      strength: 3
    - minimumMagnitude: 7500
      strength: 4
  socialEvidence:
  - actionDefinitionId: social.action.interaction
    explanationId: social.explanation.friendly_interaction
    measurements:
    - authoredId: social.measurement.friendly_interaction
