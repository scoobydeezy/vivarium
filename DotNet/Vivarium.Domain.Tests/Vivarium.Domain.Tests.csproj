<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Domain gets the majority of automated tests (§51), and it can: there is no Unity process to
    stand up, no scene to load, no frame to wait for.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Vivarium.Domain.Tests</AssemblyName>
    <RootNamespace>Vivarium.Domain.Tests</RootNamespace>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vivarium.Domain\Vivarium.Domain.csproj" />
  </ItemGroup>

</Project>
