<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Application-level tests: command ingress ordering, persistence round-trips, projections, and
    offline progression (§51). References Infrastructure for the composition root and the in-memory
    save store, which is exactly how the headless runner composes a world too.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Vivarium.Application.Tests</AssemblyName>
    <RootNamespace>Vivarium.Application.Tests</RootNamespace>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vivarium.Domain\Vivarium.Domain.csproj" />
    <ProjectReference Include="..\Vivarium.Application\Vivarium.Application.csproj" />
    <ProjectReference Include="..\Vivarium.Infrastructure\Vivarium.Infrastructure.csproj" />
  </ItemGroup>

</Project>
